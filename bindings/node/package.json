{
  "name": "fast-disambig",
  "version": "0.2.1",
  "description": "Fast Arabic morphological disambiguation and stemming",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadikhamoud/fast-disambig.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    }
  },
  "engines": {
    "node": ">=20.17"
  },
  "files": [
    "README.md",
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "check:versions": "node scripts/check-versions.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "create:npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release"
  },
  "napi": {
    "binaryName": "fast-disambig",
    "minNodeApiVersion": 4,
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.4.1"
  }
}
